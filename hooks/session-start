#!/usr/bin/env bash
# SessionStart hook for the kdd-superpowers plugin (Claude Code only).
# Injects the using-superpowers skill plus a <KDD-ENVIRONMENT> probe of the
# current project, computed with bash/find/grep only (no node at session start).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

using_superpowers_content=$(cat "${PLUGIN_ROOT}/skills/using-superpowers/SKILL.md" 2>&1 || echo "Error reading using-superpowers skill")

# --- KDD environment probe ---------------------------------------------------
# The whole probe below runs inside $(kdd_environment); bash does not enforce
# errexit the same way inside a command substitution, so empty-match
# grep/awk pipelines are safe here only because this function guards or
# tolerates them explicitly — do not assume that elsewhere in the script.
kdd_environment() {
  local toolkit specs_line open_line okf_line
  toolkit="$("${PLUGIN_ROOT}/skills/using-superpowers/scripts/kdd-cli" --path 2>/dev/null || true)"
  [ -n "$toolkit" ] || toolkit="NOT FOUND"

  if [ -d ./specs ]; then
    # --- frontmatter index --------------------------------------------------
    # One line per specs/*.md: file<TAB>id<TAB>layer<TAB>status<TAB>parent,
    # extracted ONLY from the YAML block between the first and second '---'
    # lines. This is the single source of truth for every count/lookup below
    # so that fenced examples or embedded fixtures inside a file's body can
    # never be mistaken for real spec metadata.
    local idx_file
    idx_file="$(mktemp)"
    trap 'rm -f "$idx_file"' RETURN

    local fm_awk='
      NR==1 {
        if ($0 != "---") { exit }
        in_fm=1
        next
      }
      in_fm {
        if ($0 == "---") { exit }
        line=$0
        if (line ~ /^id:/)          { sub(/^id:[ \t]*/, "", line); id=line }
        else if (line ~ /^layer:/)  { sub(/^layer:[ \t]*/, "", line); layer=line }
        else if (line ~ /^status:/) { sub(/^status:[ \t]*/, "", line); status=line }
        else if (line ~ /^parent:/) { sub(/^parent:[ \t]*/, "", line); parent=line }
      }
      END {
        if (in_fm) {
          sub(/[ \t\r]+$/, "", id)
          sub(/[ \t\r]+$/, "", layer)
          sub(/[ \t\r]+$/, "", status)
          sub(/[ \t\r]+$/, "", parent)
          printf "%s\t%s\t%s\t%s\t%s\n", FILENAME, id, layer, status, parent
        }
      }
    '
    local f
    while IFS= read -r -d '' f; do
      awk "$fm_awk" "$f" >> "$idx_file"
    done < <(find ./specs -type f -name '*.md' -print0 2>/dev/null)

    local k w
    k=$(awk -F'\t' '$3 ~ /^(architecture|domain|product|feature|documentation)$/' "$idx_file" | wc -l | tr -d ' ')
    w=$(awk -F'\t' '$3 ~ /^work-/' "$idx_file" | wc -l | tr -d ' ')
    specs_line="./specs (knowledge: ${k} · work: ${w})"

    # open work: active/completed WRK-SPECs (layer work-spec, sorted by id)
    # → their plans (layer work-plan, parent == spec id) → task progress
    # (layer work-task, parent == plan id; done = status completed|archived)
    local entries="" id st plans pid tasks total_ done_
    while IFS=$'\t' read -r _ id _ st _; do
      [ -n "$id" ] || continue
      case "$st" in active|completed) ;; *) continue ;; esac
      plans=$(awk -F'\t' -v p="$id" '$3 == "work-plan" && $5 == p { print $2 }' "$idx_file")
      if [ -z "$plans" ]; then
        entries="${entries}${entries:+; }${id} (${st})"
        continue
      fi
      while IFS= read -r pid; do
        [ -n "$pid" ] || continue
        tasks=$(awk -F'\t' -v pl="$pid" '$3 == "work-task" && $5 == pl' "$idx_file")
        total_=0; done_=0
        if [ -n "$tasks" ]; then
          total_=$(printf '%s\n' "$tasks" | grep -c . || true)
          done_=$(printf '%s\n' "$tasks" | awk -F'\t' '$4 ~ /^(completed|archived)$/' | grep -c . || true)
        fi
        entries="${entries}${entries:+; }${id} (${st}) → ${pid} → ${done_}/${total_} tasks done"
      done <<< "$plans"
    done < <(awk -F'\t' '$3 == "work-spec"' "$idx_file" | sort -t $'\t' -k2,2)
    open_line="${entries:-none}"
  else
    specs_line="NONE"
    open_line="none"
  fi

  # OKF bundles outside specs/: index.md files declaring okf_version
  local bundles="" idx dir ver
  while IFS= read -r -d '' idx; do
    grep -q '^okf_version:' "$idx" 2>/dev/null || continue
    dir=$(dirname "$idx"); dir="${dir#./}"
    ver=$(sed -n 's/^okf_version:[[:space:]]*//p' "$idx" | head -1 | tr -d '"'"'"' \r')
    bundles="${bundles}${bundles:+; }${dir} (okf_version ${ver:-?}, not imported)"
  done < <(find . -maxdepth 5 -name index.md -not -path './specs/*' -not -path '*/node_modules/*' -not -path './.git/*' -not -path './.kdd/*' -print0 2>/dev/null | sort -z)
  okf_line="${bundles:-none}"

  printf '<KDD-ENVIRONMENT>\ntoolkit: %s\nspecs_dir: %s\nopen_work: %s\nokf_bundles: %s\n</KDD-ENVIRONMENT>' \
    "$toolkit" "$specs_line" "$open_line" "$okf_line"
}
kdd_env_content="$(kdd_environment)"

# --- JSON escaping (bash parameter substitution — one pass per character class) ---
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_superpowers_escaped=$(escape_for_json "$using_superpowers_content")
kdd_env_escaped=$(escape_for_json "$kdd_env_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have kdd-superpowers.\n\n**Below is the full content of your 'kdd-superpowers:using-superpowers' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_superpowers_escaped}\n</EXTREMELY_IMPORTANT>\n\n${kdd_env_escaped}"

# Claude Code hook output. Uses printf instead of a heredoc (bash 5.3+ heredoc hang, upstream #571).
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat

exit 0
